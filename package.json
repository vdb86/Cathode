{
  "name": "cathode",
  "version": "1.0.3",
  "description": "Cathode",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "build:sabr": "node scripts/build-sabr.mjs",
    "pack": "npm run build:sabr && electron-builder --win dir",
    "dist": "npm run build:sabr && electron-builder --win zip && node scripts/pack-appzip.mjs",
    "dist:fast": "npm run build:sabr && electron-builder --win zip -c.compression=store"
  },
  "keywords": [],
  "author": "Vojislav Vlasic",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "bonjour-service": "^1.4.3",
    "googlevideo": "^4.1.1",
    "shaka-player": "^4.13.0",
    "ws": "^8.21.1",
    "youtubei.js": "^17.2.0"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1"
  },
  "build": {
    "appId": "com.cathode.app",
    "productName": "Cathode",
    "artifactName": "${productName}-${version}-win-x64.${ext}",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "icon": "src/assets/tray.ico"
    }
  }
}
